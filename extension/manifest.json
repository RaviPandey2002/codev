{
  "manifest_version": 3,
  "name": "CodeV Arena Companion",
  "version": "1.0.0",
  "description": "1-Click import of full problem statements, math formulas, and test cases from Codeforces and LeetCode into CodeV Arena.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CodeV Arena Companion",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://codeforces.com/*",
    "*://*.codeforces.com/*",
    "*://leetcode.com/*",
    "*://*.leetcode.com/*",
    "http://localhost:3007/*",
    "http://127.0.0.1:3007/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:10043/*",
    "http://127.0.0.1:10043/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/contest/*/problem/*",
        "*://codeforces.com/problemset/problem/*",
        "*://codeforces.com/gym/*/problem/*",
        "*://*.codeforces.com/contest/*/problem/*",
        "*://*.codeforces.com/problemset/problem/*",
        "*://*.codeforces.com/gym/*/problem/*"
      ],
      "js": ["content/codeforces.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://leetcode.com/problems/*",
        "*://*.leetcode.com/problems/*"
      ],
      "js": ["content/leetcode.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
